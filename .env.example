# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Роль-каналы для публикации (ID канала/чата, куда публикуются объявления)
PUBLISH_CHANNEL_ID=-1001234567890

# Администраторы (Telegram user id через запятую)
ADMIN_IDS=111111111,222222222

# PostgreSQL
POSTGRES_USER=realtor
POSTGRES_PASSWORD=realtor_password
POSTGRES_DB=realtor_bot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (хранилище состояний FSM)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-opus-4-8

# Планировщик автоподнятия объявлений (часов между поднятиями)
BUMP_INTERVAL_HOURS=24
